
* {
  box-sizing: border-box;
  margin: 0px;
  padding: 0px;
  font-family: Arial, sans-serif;
}
body {
  background-color: #ffffff;
  color: #1f2937;
  padding: 40px 20px;
}
header{
  text-align: center;
  margin-bottom: 30px;
}
main {
  background-color: #ffffff;
  width: 100%;
  max-width: 600px;
  margin: 0px auto;
  padding: 30px;
  border-radius: 12px;
  box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.08);
}
h1 {
  font-size: 38px;
  color: #4f46e5;
}

h2 {
  font-size: 24px;
  margin-bottom: 15px;
  color: #1f2937;
}


section {
  margin-bottom: 25px;
  padding-bottom: 20px;
  border-bottom: 1px solid #e5e7eb;
}
orm > div {
  margin-bottom: 15px;
}

label {
  display: block;
  font-size: 14px;
  font-weight: bold;
  margin-bottom: 6px;
}

input, select {
  width: 100%;
  padding: 10px 12px;
  font-size: 15px;
  border: 1px solid #e5e7eb;
  border-radius: 6px;
  outline: none;
}